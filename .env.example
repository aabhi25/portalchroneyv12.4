# Environment variables used by the app. On Replit, set these in the Secrets tab.
# Copy to .env for local development; never commit real values.
NODE_ENV=development
PORT=5000

# --- Required ---
DATABASE_URL=
SESSION_SECRET=
COOKIE_SECRET=
ENCRYPTION_KEY=
OTP_HMAC_SECRET=

# --- AI (chat features need at least one) ---
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=

# --- Superadmin created on first boot ---
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# --- Optional: feature-specific ---
OTP_DEV_MODE=
OTP_DEV_LOG_CODE=
APP_DOMAIN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
SENDGRID_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# --- Optional: website chat context (docs/chat-context.md) ---
# CHAT_CONTEXT_MODE=legacy          # safety valve: old "everything in the prompt" builder for all accounts
# CHAT_CONTEXT_LEGACY_ACCOUNTS=     # comma-separated business account ids that stay on the old builder
# CHAT_QUERY_REWRITE=llm            # optional small LLM rewrite of short follow-up questions (off by default)
